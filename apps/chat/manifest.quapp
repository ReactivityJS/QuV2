{
  "name": "chat",
  "version": "1.0.0",
  "kind": "app",
  "main": "./index.js",
  "clientMain": "./dist/client.js",
  "label": "Chat",
  "icon": "💭",
  "navOrder": 11,
  "requires": ["document-service", "collection-service", "thread-service"],
  "pushActions": [
    { "id": "newMessage", "label": "New messages", "type": "create" },
    { "id": "mention", "label": "Mentions", "type": "mention" }
  ],
  "actions": [
    { "mount": "contact-row", "id": "chat", "label": "Chat", "icon": "💬", "hrefTemplate": "#/chat/{pub}" }
  ]
}

{
  "name": "forum",
  "version": "1.0.0",
  "kind": "app",
  "main": "./index.js",
  "clientMain": "./dist/client.js",
  "label": "Forum",
  "icon": "💬",
  "navOrder": 10,
  "requires": ["document-service", "collection-service", "thread-service"],
  "spacePattern": "forum",
  "pushActions": [
    { "id": "mention", "label": "Mentions", "type": "mention", "requiresMention": true, "titleTemplate": "Mentioned in forum", "bodyTemplate": "~{authorShort}… sent a message", "urlTemplate": "#/forum" }
  ]
}

{
  "name": "inbox",
  "version": "1.0.0",
  "kind": "app",
  "main": "./index.js",
  "clientMain": "./dist/client.js",
  "label": "Inbox",
  "icon": "📥",
  "navOrder": 12,
  "requires": ["document-service", "collection-service", "thread-service"],
  "spacePattern": "inbox-{actorPub}",
  "pushActions": [
    { "id": "newMessage", "label": "New mail", "type": "create", "titleTemplate": "New message in inbox", "bodyTemplate": "~{authorShort}… sent a message", "urlTemplate": "#/inbox" }
  ]
}
